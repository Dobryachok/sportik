# PostgreSQL password must be URL-safe in the current Compose DATABASE_URL.
POSTGRES_PASSWORD=local-only-change-me
# Allowed browser origins for cross-site request protection, comma-separated.
# On the VM add its external address here, e.g. http://109.196.167.213.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8000
# true ONLY after configuring HTTPS, so login cookies work securely.
COOKIE_SECURE=false
# For Nominatim reverse geocoding: provide a real contact email before deploying.
GEO_CONTACT_EMAIL=
GEO_USER_AGENT=SportVmeste/1.0
