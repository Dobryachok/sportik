# PostgreSQL password must be URL-safe in the current Compose DATABASE_URL.
POSTGRES_PASSWORD=local-only-change-me
# Allowed browser origins for cross-site request protection, comma-separated.
# On the VM add its external address here, e.g. http://109.196.167.213.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8000
# true ONLY after configuring HTTPS, so login cookies work securely.
COOKIE_SECURE=false
# For Nominatim reverse geocoding and address suggestions: provide a real contact email before deploying.
GEO_CONTACT_EMAIL=
GEO_SEARCH_URL=https://nominatim.openstreetmap.org/search
GEO_USER_AGENT=Sportik/1.0
# Email that receives the ADMIN role after registration or login (no default password in the app).
# Register once on the site with this email and your own password (10+ chars, letters and digits).
# Example: ADMIN_EMAIL=admin@sportik.local
ADMIN_EMAIL=
# Set false to start without mock catalog records.
SEED_MOCK_DATA=true
