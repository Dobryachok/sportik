DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/sport
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
SESSION_COOKIE_NAME=sport_session
SESSION_DAYS=14
# Set true when the API is served over HTTPS.
COOKIE_SECURE=false
# Local backend without Docker: relative writable directory.
# Docker Compose uses /data/avatars with a named persistent volume.
UPLOAD_DIR=./uploads/avatars
# Use a real contact address for Nominatim reverse geocoding and address suggestions.
GEO_CONTACT_EMAIL=
GEO_SEARCH_URL=https://nominatim.openstreetmap.org/search
GEO_USER_AGENT=Sportik/1.0
GEO_TIMEOUT_SECONDS=5
DEFAULT_CITY=
# Optional: email of the account that may use the administration panel.
# The account still needs to register or log in with its own password.
ADMIN_EMAIL=
# Set false to start without mock catalog records.
SEED_MOCK_DATA=true
